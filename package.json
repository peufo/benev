{
	"name": "benev",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prestart": "prisma migrate deploy",
		"start": "bun ./build/index.js",
		"postinstall": "prisma generate",
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview --host",
		"generate": "prisma generate",
		"timezones": "node scripts/timezones.mjs",
		"fuma:local": "bun add fuma@file:../fuma",
		"fuma:npm": "bun add fuma@latest",
		"migrate": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"studio": "prisma studio",
		"vitest": "vitest",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"test-gen": "playwright codegen localhost:5173",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && bun run lint",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"dev:stripe": "stripe listen --forward-to localhost:5173/me/checkouts/validation"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.54.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/debounce": "^1.2.4",
		"@types/nodemailer": "^6.4.14",
		"@types/object-path": "^0.11.4",
		"@types/pdfkit": "^0.17.4",
		"@types/qrcode": "^1.5.6",
		"daisyui": "^5.7.4",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prisma": "^6.19.3",
		"prisma-json-types-generator": "^3.6.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@lucia-auth/adapter-prisma": "^3.0.2",
		"@lucia-auth/oauth": "^3.5.1",
		"@lucide/svelte": "^1.27.0",
		"@paralleldrive/cuid2": "^2.2.2",
		"@prisma/client": "^6.19.3",
		"@stripe/stripe-js": "^2.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tiptap/core": "^2.3.0",
		"@tiptap/extension-color": "^2.3.0",
		"@tiptap/extension-highlight": "^2.3.0",
		"@tiptap/extension-image": "^2.3.0",
		"@tiptap/extension-link": "^2.3.0",
		"@tiptap/extension-mention": "^2.3.0",
		"@tiptap/extension-placeholder": "^2.3.0",
		"@tiptap/extension-text-align": "^2.3.0",
		"@tiptap/extension-text-style": "^2.3.0",
		"@tiptap/extension-youtube": "^2.3.0",
		"@tiptap/html": "^2.3.0",
		"@tiptap/pm": "^2.3.0",
		"@tiptap/starter-kit": "^2.3.0",
		"@tiptap/suggestion": "^2.3.0",
		"dayjs": "^1.11.10",
		"debounce": "^1.2.1",
		"devalue": "^5.8.1",
		"fuma": "^2.2.7",
		"ical-generator": "^8.1.1",
		"js-confetti": "^0.11.0",
		"litepicker": "^2.0.12",
		"lucia": "^2.7.6",
		"nodemailer": "^6.9.7",
		"object-path": "^0.11.8",
		"pdfkit": "^0.17.2",
		"perod": "^1.4.1",
		"qrcode": "^1.5.4",
		"sharp": "^0.33.3",
		"stripe": "^14.8.0",
		"svelte-easy-crop": "^5.0.1",
		"svelte-meta-tags": "^5.0.2",
		"svelte-portal": "^2.2.1",
		"svelte-sonner": "^1.1.1",
		"tippy.js": "^6.3.7",
		"zod": "^4.1.11"
	},
	"license": "AGPL-3.0-or-later",
	"author": "Dev Voisard <jonas.voisard@gmail.com>",
